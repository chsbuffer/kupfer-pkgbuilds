prepare() {
    cd "$srcdir/linux-$_tag"
    patch -Np1 -i "$srcdir/0001-Added-POCO-F3-dts-panel-and-touchscreen-drivers.patch"
    patch -Np1 -i "$srcdir/0002-alioth-hyperos-firmware-memory-layout.patch"
    patch -Np1 -i "$srcdir/0002-Disable-panel-and-touchscreen.patch"
    cp "$srcdir/config-postmarketos-qcom-sm8250-alioth.aarch64" .config
    make ARCH=arm64 LLVM=1 olddefconfig
}

build() {
    cd "$srcdir/linux-$_tag"
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    make ARCH=arm64 LLVM=1 KBUILD_BUILD_VERSION="2-postmarketos-qcom-sm8250-alioth" Image.gz modules dtbs
}

package() {
    cd "$srcdir/linux-$_tag"
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    local kernver
    kernver="$(make -s ARCH=arm64 LLVM=1 kernelrelease)"
    make ARCH=arm64 LLVM=1 DEPMOD=/usr/bin/true         INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
    local link
    for link in "$pkgdir/usr/lib/modules/$kernver/build" "$pkgdir/usr/lib/modules/$kernver/source"; do
        if [[ -L "$link" ]]; then unlink "$link"; fi
    done
    depmod -b "$pkgdir/usr" -F System.map "$kernver"
    install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
    install -Dm644 arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth.dtb         "$pkgdir/boot/dtbs/qcom/sm8250-xiaomi-alioth.dtb"
    install -Dm644 .config "$pkgdir/boot/config-linux-sm8250-alioth"
    install -Dm644 System.map "$pkgdir/boot/System.map-linux-sm8250-alioth"
    printf '%s\n' "$pkgname" > "$pkgdir/usr/lib/modules/$kernver/pkgbase"
    # No separate extramodules directory is shipped by this kernel.
    local subst="s/%PKGBASE%/$pkgname/g; s/%KERNVER%/$kernver/g; /%EXTRAMODULES%/d"
    sed "$subst" "$srcdir/linux.preset" |
        install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/linux.preset"
    local hook
    for hook in 60 90; do
        sed "$subst" "$srcdir/$hook-linux.hook" |
            install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/$hook-$pkgname.hook"
    done
}
