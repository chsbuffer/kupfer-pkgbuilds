prepare() {
    cd "$srcdir/linux-$_tag"
    # Re-extraction leaves files added by patches in an existing source tree.
    rm -f arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth.dts \
        drivers/gpu/drm/panel/panel-samsung-ams667xx01.c \
        drivers/input/touchscreen/ft8756.c
    patch -Np1 -i "$srcdir/0001-Added-POCO-F3-dts-panel-and-touchscreen-drivers.patch"
    patch -Np1 -i "$srcdir/0002-alioth-hyperos-firmware-memory-layout.patch"
    patch -Np1 -i "$srcdir/0002-Disable-panel-and-touchscreen.patch"
    patch -Np1 -i "$srcdir/0003-alioth-connect-usb-vbus-supply.patch"
    cp "$srcdir/config-postmarketos-qcom-sm8250-alioth.aarch64" .config
    cat ../extra_config >>.config
    echo 'CONFIG_NETFILTER_XT_CONNMARK=m' >>.config
    echo 'CONFIG_NETFILTER_XT_SET=m' >>.config
    make ARCH=arm64 LLVM=1 olddefconfig
}

build() {
    cd "$srcdir/linux-$_tag"
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    make ARCH=arm64 LLVM=1 KBUILD_BUILD_VERSION="2-postmarketos-qcom-sm8250-alioth" Image.gz modules dtbs
}

package_linux-sm8250-alioth() {
    cd "$srcdir/linux-$_tag"
    unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    local kernver
    kernver="$(make -s ARCH=arm64 LLVM=1 kernelrelease)"
    make ARCH=arm64 LLVM=1 DEPMOD=/usr/bin/true         INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 modules_install
    local link
    for link in "$pkgdir/usr/lib/modules/$kernver/build" "$pkgdir/usr/lib/modules/$kernver/source"; do
        if [[ -L "$link" ]]; then unlink "$link"; fi
    done
    depmod -b "$pkgdir/usr" -F System.map "$kernver"
    install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/Image.gz"
    install -Dm644 arch/arm64/boot/dts/qcom/sm8250-xiaomi-alioth.dtb         "$pkgdir/boot/dtbs/qcom/sm8250-xiaomi-alioth.dtb"
    install -Dm644 .config "$pkgdir/boot/config-linux-sm8250-alioth"
    install -Dm644 System.map "$pkgdir/boot/System.map-linux-sm8250-alioth"
    printf '%s\n' "$pkgbase" > "$pkgdir/usr/lib/modules/$kernver/pkgbase"
    # No separate extramodules directory is shipped by this kernel.
    local subst="s/%PKGBASE%/$pkgbase/g; s/%KERNVER%/$kernver/g; /%EXTRAMODULES%/d"
    sed "$subst" "$srcdir/linux.preset" |
        install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/linux.preset"
    local hook
    for hook in 60 90; do
        sed "$subst" "$srcdir/$hook-linux.hook" |
            install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/$hook-$pkgbase.hook"
    done
}

package_linux-sm8250-alioth-headers() {
    pkgdesc="Headers and build scripts for the Xiaomi alioth kernel"
    depends=(clang llvm lld)
    backup=()

    cd "$srcdir/linux-$_tag"
    local kernver builddir
    kernver="$(make -s ARCH=arm64 LLVM=1 kernelrelease)"
    builddir="$pkgdir/usr/lib/modules/$kernver/build"

    # DKMS needs the prepared build tree and symbol table from this kernel.
    install -Dt "$builddir" -m644 Makefile .config Module.symvers System.map
    install -Dt "$builddir/kernel" -m644 kernel/Makefile
    cp -a include scripts "$builddir/"

    install -Dt "$builddir/arch/arm64" -m644 arch/arm64/Makefile
    install -Dt "$builddir/arch/arm64/kernel" -m644 arch/arm64/kernel/asm-offsets.s
    cp -a arch/arm64/include arch/arm64/tools "$builddir/arch/arm64/"
    mkdir -p "$builddir/arch/arm"
    cp -a arch/arm/include "$builddir/arch/arm/"

    find . -type f -name 'Kconfig*' -exec cp --parents -t "$builddir" {} +

    if grep -q '^CONFIG_DEBUG_INFO_BTF_MODULES=y' .config; then
        install -Dt "$builddir" -m644 vmlinux
        install -Dt "$builddir/tools/bpf/resolve_btfids" -m755 \
            tools/bpf/resolve_btfids/resolve_btfids
    fi

    # DTC contains source-tree links that are not needed to build modules.
    find -L "$builddir" -type l -delete
    chmod -R u=rwX,go=rX "$builddir"
}
