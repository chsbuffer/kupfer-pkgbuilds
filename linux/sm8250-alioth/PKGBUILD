_mode=cross
_nodeps=true
pkgname=linux-sm8250-alioth
pkgver=7.2.0
pkgrel=3
pkgdesc="Qualcomm SM8250 kernel for Xiaomi alioth (HyperOS memory layout)"
_arches=specific
arch=(aarch64)
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux"
license=(GPL-2.0-only)
depends=(coreutils kmod mkinitcpio)
makedepends=(bc bison flex clang llvm lld libelf openssl pahole python kmod cpio dtc)
options=(!strip !debug !lto)
backup=(etc/mkinitcpio.d/linux.preset)
_tag="sm8250-$pkgver"
_archive="linux-postmarketos-qcom-sm8250-alioth-$_tag.tar.gz"
source=(
    "$_archive::$url/-/archive/$_tag/linux-$_tag.tar.gz"
    config-postmarketos-qcom-sm8250-alioth.aarch64
    0001-Added-POCO-F3-dts-panel-and-touchscreen-drivers.patch
    0002-alioth-hyperos-firmware-memory-layout.patch
    0002-Disable-panel-and-touchscreen.patch
    linux.preset
    60-linux.hook
    90-linux.hook
)
sha512sums=(
