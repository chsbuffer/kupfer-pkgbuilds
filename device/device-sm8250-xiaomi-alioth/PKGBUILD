package() {
    install -Dm644 "$srcdir/deviceinfo" "$pkgdir/etc/kupfer/deviceinfo"
    install -Dm644 "$srcdir/alioth.conf" "$pkgdir/etc/kupfer/mkinitcpio.conf.d/alioth.conf"
    install -Dm644 "$srcdir/alioth.lst" "$pkgdir/etc/kupfer/systemd/alioth.lst"
    install -Dm644 "$srcdir/wifi-powersave.conf" "$pkgdir/etc/NetworkManager/conf.d/wifi-powersave.conf"
    install -Dm644 "$srcdir/81-libssc-xiaomi-alioth.rules" "$pkgdir/usr/lib/udev/rules.d/81-libssc-xiaomi-alioth.rules"
    install -Dm644 "$srcdir/alioth-ucm.conf" "$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/alioth.conf"
    install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/HiFi.conf"
    install -dm755 "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
    ln -s ../../Xiaomi/alioth/alioth.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/xiaomi-alioth.conf"
}
